{
  "test_cases": [
    {
      "test_case": {
        "name": "登录测试",
        "description": "登录 counter98 柜台，后续查询的前置条件",
        "counter_type": "gw_direct",
        "timeout_ms": 5000
      },
      "request": {
        "type": "login",
        "fields": {
          "client_req_no": 1001,
          "fund_account_id": "1000000000000001",
          "branch_id": "0001",
          "account_id": "A12345678901",
          "cust_id": "C000000000000001",
          "password": "TEST000000001",
          "order_way_ext": "7",
          "user_info": "mock_client"
        }
      },
      "expected_response": {
        "type": "login",
        "fields": {
          "cust_id": "C000000000000001",
          "fund_account_id": "1000000000000001",
          "account_id": "A12345678901",
          "branch_id": "0001",
          "err_code": 0
        },
        "validate": ["err_code"]
      }
    },
